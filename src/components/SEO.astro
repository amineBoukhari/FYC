---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';

export interface Props {
  title: string;
  description?: string;
  // Image de partage : une image importée (recadrée en 1200×630) ou, à défaut, /og-default.jpg.
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt = SITE.author,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} | ${SITE.author}`;

// URL canonique absolue, sans paramètres de requête (?utm_source=… ne crée pas de doublon).
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })).src, Astro.site)
  : new URL('/og-default.jpg', Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* Une page noindex n'a pas de version de référence à désigner : pas de canonical. */}
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

{/* Open Graph : aperçu lors d'un partage (LinkedIn, Slack, Discord, messageries…) */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.author} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

{/* X / Twitter réutilise og:title, og:description et og:image ; seule la carte est à préciser */}
<meta name="twitter:card" content="summary_large_image" />
