---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="hero">
  <img src="/images/hero.jpg" alt="Capture stylisée d’un éditeur de code" />
  <div class="container content">
    <slot name="eyebrow" />
    <h1>{title}</h1>
    <p class="lead">{subtitle}</p>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: #fff;
    overflow: hidden;
    background: #0f172a;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .content {
    position: relative;
    padding-block: 6rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
    max-width: 48rem;
  }

  .lead {
    color: #e2e8f0;
  }
</style>
