---
interface Props {
  title: string;
  tone?: 'tip' | 'info';
}

const { title, tone = 'tip' } = Astro.props;
---

<aside class:list={['callout', tone]}>
  <p class="title">{title}</p>
  <slot />
</aside>

<style>
  .callout {
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: #eef2ff;
  }

  .callout.info {
    border-color: #0e7490;
    background: #ecfeff;
  }

  .title {
    margin: 0 0 0.25rem;
    font-weight: 700;
  }
</style>
