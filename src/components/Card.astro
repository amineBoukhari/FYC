---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
---

<article class="card">
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <slot />
</article>

<style>
  .card {
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  h3 {
    margin-top: 0;
  }

  h3 a {
    color: inherit;
  }
</style>
