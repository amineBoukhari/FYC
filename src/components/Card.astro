---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  // Niveau du titre selon le contexte : h2 directement sous le h1 de la page, h3 sous un h2.
  level?: 2 | 3;
}

const { title, href, image, imageAlt = '', level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="card">
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 800]}
        sizes="(min-width: 72rem) 23rem, (min-width: 40rem) 45vw, 100vw"
      />
    )
  }
  <div class="body">
    <Heading class="title">{href ? <a href={href}>{title}</a> : title}</Heading>
    <slot />
  </div>
</article>

<style>
  .card {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .body {
    padding: 1.5rem;
  }

  .title {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .title a {
    color: inherit;
  }
</style>
