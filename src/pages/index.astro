---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import { SITE } from '../data/site';
import { formatDate } from '../utils/format';
import JsonLd from '../components/JsonLd.astro';
import { graph, personSchema, websiteSchema } from '../utils/schema';

const skills = [
  {
    title: 'Front-end',
    text: 'Interfaces en HTML sémantique, CSS moderne et TypeScript, avec Astro, React ou Svelte selon le besoin.',
  },
  {
    title: 'Performance web',
    text: 'Optimisation des Core Web Vitals : images, chargement du JavaScript, rendu côté serveur.',
  },
  {
    title: 'SEO technique',
    text: 'Balisage, données structurées, sitemap : des sites que les moteurs comprennent et indexent.',
  },
];

const featured = (await getCollection('projets', ({ data }) => data.featured)).sort((a, b) => b.data.year - a.data.year);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Développement web front-end">
  <JsonLd slot="head" schema={graph(websiteSchema(Astro.site!), personSchema(Astro.site!))} />
  <Hero
    title="Je conçois des sites web rapides, accessibles et bien référencés"
    subtitle={SITE.intro}
  >
    <p class="actions">
      <a class="button" href="/projets/">Voir mes projets</a>
      <a class="button ghost" href="/contact/">Me contacter</a>
    </p>
  </Hero>

  <section class="section container">
    <h2>Que puis-je faire pour votre projet ?</h2>
    <div class="grid">
      {
        skills.map(({ title, text }) => (
          <Card title={title}>
            <p>{text}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2>Projets à la une</h2>
    <div class="grid">
      {
        featured.map(({ id, data }) => (
          <Card title={data.title} href={`/projets/${id}/`} image={data.cover} imageAlt={data.coverAlt}>
            <p>{data.summary}</p>
          </Card>
        ))
      }
    </div>
    <p><a href="/projets/">Tous les projets →</a></p>
  </section>

  <section class="section container">
    <h2>Derniers articles</h2>
    <ul class="posts">
      {
        posts.map(({ id, data }) => (
          <li>
            <a href={`/blog/${id}/`}>{data.title}</a>
            <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .posts {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .posts li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .posts time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
