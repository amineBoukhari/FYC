---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { formatDate } from '../../utils/format';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Articles techniques sur Astro, la performance web, l'accessibilité et le référencement.">
  <section class="section container">
    <h1>Blog</h1>
    <p class="lead">Retours d'expérience et notes techniques : rendu, performance, accessibilité, référencement.</p>

    <div class="grid">
      {
        posts.map(({ id, data }) => (
          <Card title={data.title} href={`/blog/${id}`} image={data.cover} imageAlt={data.coverAlt}>
            <p class="date">
              <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
            </p>
            <p>{data.description}</p>
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .date {
    margin-top: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
