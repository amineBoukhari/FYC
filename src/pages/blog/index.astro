---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import JsonLd from '../../components/JsonLd.astro';
import { formatDate } from '../../utils/format';
import { collectionPageSchema, graph } from '../../utils/schema';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const description = "Articles techniques sur Astro, la performance web, l'accessibilité et le référencement.";
const schema = graph(
  collectionPageSchema(
    { name: 'Blog', description, path: '/blog/' },
    posts.map(({ id, data }) => ({ name: data.title, path: `/blog/${id}/` })),
    Astro.site!,
  ),
);
---

<BaseLayout title="Blog" description={description}>
  <JsonLd slot="head" schema={schema} />

  <section class="section container">
    <h1>Blog</h1>
    <p class="lead">Des articles techniques écrits à partir de projets réels : choisir un mode de rendu, améliorer les Core Web Vitals, rendre une interface accessible et bien référencer un site Astro.</p>

    <div class="grid">
      {
        posts.map(({ id, data }) => (
          <Card level={2} title={data.title} href={`/blog/${id}/`} image={data.cover} imageAlt={data.coverAlt}>
            <p class="date">
              <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
            </p>
            <p>{data.description}</p>
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .date {
    margin-top: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
