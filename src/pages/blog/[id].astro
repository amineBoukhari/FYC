---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../data/site';
import { formatDate } from '../../utils/format';
import { blogPostingSchema, breadcrumbSchema, graph } from '../../utils/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content } = await render(post);

// Maillage interne : les articles qui partagent le plus de thèmes avec celui-ci.
const related = posts
  .filter((other) => other.id !== post.id)
  .map((other) => ({ other, score: other.data.tags.filter((tag) => data.tags.includes(tag)).length }))
  .sort((a, b) => b.score - a.score || b.other.data.pubDate.valueOf() - a.other.data.pubDate.valueOf())
  .slice(0, 2)
  .map(({ other }) => other);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: data.title, href: `/blog/${post.id}/` },
];

// Même image que l'aperçu Open Graph (1200×630), en URL absolue.
const shareImage = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg' });
const site = Astro.site!;
const schema = graph(
  blogPostingSchema(post, new URL(shareImage.src, site).href, site),
  breadcrumbSchema(crumbs, site),
);
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.cover}
  imageAlt={data.coverAlt}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
>
  <JsonLd slot="head" schema={schema} />

  <article class="section container post">
    <Breadcrumbs items={crumbs} />
    <header>
      <h1>{data.title}</h1>
      <p class="meta">
        Par <a href="/a-propos/">{SITE.author}</a> — publié le <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      </p>
      <ul class="tags" aria-label="Thèmes">
        {data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    <Image src={data.cover} alt={data.coverAlt} widths={[480, 768, 1536]} sizes="(min-width: 48rem) 48rem, 100vw" priority />
    <div class="prose">
      <Content />
    </div>

    <aside class="related" aria-labelledby="related-title">
      <h2 id="related-title">À lire aussi</h2>
      <ul>
        {
          related.map((other) => (
            <li>
              <a href={`/blog/${other.id}/`}>{other.data.title}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 48rem;
  }

  .meta {
    color: var(--color-muted);
  }

  img {
    border-radius: var(--radius);
    margin-block: 2rem;
  }

  .prose :global(pre) {
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
</style>
