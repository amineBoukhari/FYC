---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema, graph, projectSchema } from '../../utils/schema';

// SSG : une page HTML est générée au build pour chaque fichier de la collection.
export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({ params: { id: projet.id }, props: { projet, projets } }));
}

const { projet, projets } = Astro.props;
const { data } = projet;
const { Content } = await render(projet);

// Maillage interne : les projets qui partagent au moins une technologie.
const related = projets
  .filter((other) => other.id !== projet.id && other.data.stack.some((tech) => data.stack.includes(tech)))
  .slice(0, 2);

const crumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Projets', href: '/projets/' },
  { label: data.title, href: `/projets/${projet.id}/` },
];

const shareImage = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg' });
const site = Astro.site!;
const schema = graph(projectSchema(projet, new URL(shareImage.src, site).href, site), breadcrumbSchema(crumbs, site));
---

<BaseLayout title={`${data.title} — étude de cas`} description={data.summary} image={data.cover} imageAlt={data.coverAlt}>
  <JsonLd slot="head" schema={schema} />

  <article class="section container project">
    <Breadcrumbs items={crumbs} />
    <header>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <dl>
        <div>
          <dt>Année</dt>
          <dd>{data.year}</dd>
        </div>
        <div>
          <dt>Rôle</dt>
          <dd>{data.role}</dd>
        </div>
        {
          data.demo && (
            <div>
              <dt>En ligne</dt>
              <dd>
                <a href={data.demo}>{data.demo.replace('https://', '')}</a>
              </dd>
            </div>
          )
        }
      </dl>
      <ul class="tags" aria-label="Technologies">
        {data.stack.map((tech) => <li>{tech}</li>)}
      </ul>
    </header>

    <Image src={data.cover} alt={data.coverAlt} widths={[480, 768, 1536]} sizes="(min-width: 48rem) 48rem, 100vw" />

    <div class="prose">
      <Content />
    </div>

    <aside class="related" aria-labelledby="related-title">
      <h2 id="related-title">{related.length ? 'Projets similaires' : 'Voir aussi'}</h2>
      <ul>
        {
          related.map((other) => (
            <li>
              <a href={`/projets/${other.id}/`}>{other.data.title}</a> — {other.data.summary}
            </li>
          ))
        }
        <li>
          <a href="/projets/">Tous les projets</a>
        </li>
        <li>
          <a href="/contact/">Discuter d'un projet similaire</a>
        </li>
      </ul>
    </aside>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 48rem;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  dt {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  img {
    margin-block: 2rem;
    border-radius: var(--radius);
  }

  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
</style>
